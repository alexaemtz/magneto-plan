rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function selfPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // exists() + get() para el mismo path en la misma evaluación cuentan como
    // una sola lectura (Firebase cachea dentro del request).
    function isActive() {
      return isAuth()
          && exists(selfPath())
          && get(selfPath()).data.active == true;
    }

    function isAdmin() {
      return isActive()
          && get(selfPath()).data.role == 'admin';
    }

    function userPerms() {
      return get(selfPath()).data.permissions;
    }

    function canCreate(page) {
      return isAdmin() || userPerms()[page].create == true;
    }

    function canUpdate(page) {
      return isAdmin() || userPerms()[page].update == true;
    }

    function canDelete(page) {
      return isAdmin() || userPerms()[page].delete == true;
    }

    // ── Usuarios ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Lectura: propio doc o admin.
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());

      // Creación: solo el propio usuario (primer login).
      allow create: if isAuth() && request.auth.uid == userId;

      // Actualización:
      //   • Propio usuario: puede actualizar cualquier campo EXCEPTO role, active y permissions.
      //   • Admin: puede actualizar cualquier campo de cualquier usuario.
      allow update: if isAuth() && (
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['role', 'active', 'permissions'])
        ) || isAdmin()
      );
    }

    // ── Catálogos: lectura para todos los activos, escritura solo admins ───────
    match /advisors/{docId} {
      allow read:  if isActive();
      allow write: if isAdmin();
    }

    match /carModels/{docId} {
      allow read:  if isActive();
      allow write: if isAdmin();
    }

    match /tecnicos/{docId} {
      allow read:  if isActive();
      allow write: if isAdmin();
    }

    // ── Citas ────────────────────────────────────────────────────────────────
    match /appointments/{docId} {
      allow read:   if isActive();
      allow create: if isActive() && (canCreate('gantt') || canCreate('dashboard'));
      allow update: if isActive() && (canUpdate('gantt') || canUpdate('dashboard'));
      allow delete: if isActive() && (canDelete('gantt') || canDelete('dashboard'));
    }

    // ── Indicadores diarios ───────────────────────────────────────────────────
    match /dailyIndicators/{docId} {
      allow read:   if isActive();
      allow write:  if isActive() && canUpdate('indicador');
    }

    // ── Casos pendientes ──────────────────────────────────────────────────────
    match /pendingCases/{docId} {
      allow read:   if isActive();
      allow create: if isActive() && canCreate('casosPendientes');
      allow update: if isActive() && canUpdate('casosPendientes');
      allow delete: if isActive() && canDelete('casosPendientes');
    }

    // ── Refacciones ───────────────────────────────────────────────────────────
    match /refacciones/{docId} {
      allow read:   if isActive();
      allow create: if isActive() && canCreate('refacciones');
      allow update: if isActive() && canUpdate('refacciones');
      allow delete: if isActive() && canDelete('refacciones');
    }
  }
}
